FROM python:3.11-slim
RUN useradd -r -u 10001 app
WORKDIR /app
COPY inference/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY inference/preprocess.py inference/server.py ./
USER app
ENV MODEL_DIR=/models BACKEND=auto
EXPOSE 9000
CMD ["python", "-m", "uvicorn", "server:app", "--host", "0.0.0.0", "--port", "9000", "--log-level", "warning"]
