# Copy to .env and fill in. Generate secrets with:  openssl rand -base64 48
APP_ENV=production
PUBLIC_HOST=oscc.example.org            # DNS name Caddy will obtain a TLS certificate for
INTERNAL_TOKEN=change-me-at-least-32-random-chars
SESSION_SECRET=change-me-at-least-32-random-chars
ALLOWED_DOMAINS=hospital.org            # and/or ALLOWED_EMAILS=a@x.org,b@y.org  (deny-by-default)
SMTP_HOST=smtp.example.org
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=change-me
SMTP_FROM="OSCC Assistant <no-reply@hospital.org>"
